void setup() {
  Serial.begin(9600);

  // Start I2C 
  Wire.begin(I2C_SDA, I2C_SCL);

  // Start screen
  display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS);
  display.clearDisplay();
  startingFrames();
  sensorFrame();
}

void loop() {
  // TODO
}

void startingFrames() {
  //-------------------WELCOME SCREEN ----------------------------
  // Clear display and draw content
  display.clearDisplay();

  // Show text
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setFont(&Picopixel);
  display.setCursor(25, 8);
  display.println("GAS AND CO2");
  display.setCursor(30, 22);
  display.println("SENSOR IoT");

  //Show image
  display.drawBitmap(30, 36, kirbyImage, 70, 38, SSD1306_WHITE);

  //Show content in the screen
  display.display();

  //wait five seconds
  delay(6000);

  //-------------------BY SCREEN -------------------------------
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setFont(&Picopixel);
  display.setCursor(25, 30);
  display.println("By Andy Val");
  display.setCursor(5, 44);
  display.println("Github: Kazuhira97");
  display.display();
  delay(4000);

  //-------------------CALIBRATING SCREEN --------------------------
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setFont(&Picopixel);
  display.setCursor(30, 30);
  display.println("Calibrating");
  display.setCursor(35, 44);
  display.println("sensors...");
  display.display();
  delay(3000);
}

void sensorFrame() {
  int GAS_LP = 1234; // Dummy data
  int CO_2 = 1234;
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setFont(&Picopixel);

  //Measurements headers
  display.setCursor(15, 25);
  display.println("GAS LP");
  display.setCursor(85, 25);
  display.println("CO2");

  //Unit headers
  display.setCursor(17, 39);
  display.println("(ppm)");
  display.setCursor(78, 39);
  display.println("(ppm)");

  //Measurements data
  display.setCursor(20, 60);
  display.println(String(GAS_LP));
  display.setCursor(81, 60);
  display.println(String(CO_2));

  display.display();
}